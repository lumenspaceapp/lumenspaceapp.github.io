rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isMember(ws) {
      return signedIn() && myEmail() in get(/databases/$(database)/documents/workspaces/$(ws)).data.members;
    }

    match /workspaces/{ws} {
      // list/read only workspaces you were invited to
      allow read: if signedIn() && myEmail() in resource.data.members;
      // create a workspace you own and belong to
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && myEmail() in request.resource.data.members;
      // members can rename / reorder; only the owner can change members or ownership
      allow update: if signedIn() && myEmail() in resource.data.members
        && (resource.data.owner == request.auth.uid
            || (request.resource.data.members == resource.data.members
                && request.resource.data.owner == resource.data.owner));
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /pages/{page} {
        allow read, write: if isMember(ws);
      }
      // business apps (tasks, chat, CRM, …): any member can read and write
      match /{coll}/{docId} {
        allow read, write: if isMember(ws) && coll in ['tasks', 'projects', 'chat', 'channels', 'feed', 'events', 'leads', 'deals',
          'contacts', 'companies', 'people', 'absences', 'timelog', 'files', 'folders', 'rules', 'notifications'];
      }
      match /presence/{uid} {
        allow read: if isMember(ws);
        allow write: if isMember(ws) && uid == request.auth.uid;
        // the owner may clear everyone's presence when deleting the workspace
        allow delete: if signedIn() && get(/databases/$(database)/documents/workspaces/$(ws)).data.owner == request.auth.uid;
      }
    }
  }
}
